#!/bin/bash
# Hook: pre-commit
# Réf: ENGINEERING_PLAYBOOK.md §1, §5, §6, §12

# 0. Vérification de la branche (Protection Anti-Contournement)
BRANCH=$(git rev-parse --abbrev-ref HEAD)
if [ "$BRANCH" = "main" ] || [ "$BRANCH" = "master" ]; then
  echo -e "\033[31mErreur: Commits directs sur '$BRANCH' strictement interdits (Playbook §5).\033[0m"
  echo "L'IA ou le développeur humain doit créer une branche (git checkout -b <nom-branche>) et passer par une Pull Request."
  exit 1
fi

# 1. Vérification des secrets en clair
# Recherche de patterns de type api_key="qqchose", token stripe/openai, slack...
SECRETS=$(git diff --cached -G"(api_key|secret|token|password)[ ]*=[ ]*['\"][a-zA-Z0-9_\-]+['\"]|(sk-[a-zA-Z0-9]{20,48})|(xox[baprs]-[0-9a-zA-Z]{10,48})" --name-only)
if [ -n "$SECRETS" ]; then
  echo -e "\033[31mErreur: Potentiel secret en clair (API key, token, mot de passe) détecté dans les fichiers suivants :\033[0m"
  echo "$SECRETS"
  echo "Bloqué selon le Playbook. Utilisez des variables d'environnement."
  exit 1
fi

# 2. Vérification des fichiers de debug non voulus et des scories dans le code
DEBUG_FILES=$(git diff --cached --name-only | grep -E "(^|/)(debug_|test_|\.tmp$)")
if [ -n "$DEBUG_FILES" ]; then
  echo -e "\033[31mErreur: Fichier temporaire ou de debug détecté :\033[0m"
  echo "$DEBUG_FILES"
  exit 1
fi

SCORIA=$(git diff --cached -G"debugger;" --name-only)
if [ -n "$SCORIA" ]; then
  echo -e "\033[31mErreur: Instruction 'debugger;' détectée dans :\033[0m"
  echo "$SCORIA"
  echo "Nettoyez votre code de debug avant de commiter."
  exit 1
fi

LOGS=$(git diff --cached -G"console\.log[[:space:]]*\(" --name-only | grep -vE "(^|/)(scripts|generator|tests)/")
if [ -n "$LOGS" ]; then
  echo -e "\033[33mAvertissement: Des 'console.log' ont été détectés dans les fichiers suivants :\033[0m"
  echo "$LOGS"
  echo "Assurez-vous qu'il ne s'agit pas d'oublis de debug."
fi

# 3. Synchronisation IA (Cursor / Windsurf)
if [ -f ".cursorrules" ] && [ -f ".windsurfrules" ]; then
  if ! cmp -s .cursorrules .windsurfrules; then
    echo -e "\033[31mErreur: .cursorrules et .windsurfrules sont désynchronisés.\033[0m"
    echo "Copiez le contenu de l'un dans l'autre pour maintenir la cohérence de l'IA (Playbook)."
    exit 1
  fi
fi

# 4. Lint / Format (Dégradation progressive acceptable)
# On tente de trouver une commande de lint dans les scripts standards, sinon on avertit.
if [ -f "package.json" ] && grep -q '"lint"' package.json; then
  echo "Exécution du linter npm..."
  npm run lint || { echo -e "\033[31mErreur Lint\033[0m"; exit 1; }
elif [ -f "Makefile" ] && grep -q "^lint:" Makefile; then
  echo "Exécution du linter Make..."
  make lint || { echo -e "\033[31mErreur Lint\033[0m"; exit 1; }
else
  echo -e "\033[33mAvertissement: Aucun linter standard détecté (npm run lint, make lint). Configurez-en un dans PROJECT_CONFIG.md.\033[0m"
fi

# 5. Taille des fichiers modifiés (HARD LIMIT)
# Réf: ADR-002 - Distinction entre code source et artefacts générés
for file in $(git diff --cached --name-only); do
  if [ -f "$file" ]; then
    # Exclure les artefacts générés (lock files) selon ADR-002
    if [[ "$file" =~ (package-lock\.json|yarn\.lock|pnpm-lock\.yaml|composer\.lock|Cargo\.lock)$ ]]; then
      continue
    fi
    LINES=$(wc -l < "$file")
    if [ "$LINES" -gt 400 ]; then
      echo -e "\033[31mErreur: Le fichier $file dépasse la Hard Limit de 400 lignes ($LINES lignes).\033[0m"
      echo "Découpez-le avant de commiter (Playbook §1)."
      exit 1
    fi
  fi
done

# 6. Anti-Bypass Linters (exclure les fichiers markdown et hooks)
BYPASS=$(git diff --cached -G"(eslint-disable|@ts-ignore|biome-ignore)" --name-only | grep -vE "(\.md$|^hooks/)")
if [ -n "$BYPASS" ]; then
  echo -e "\033[31mErreur: Contournement de Linter détecté dans les fichiers :\033[0m"
  echo "$BYPASS"
  echo "Le Playbook interdit d'ignorer silencieusement le linter. Corrigez le code."
  exit 1
fi

# 7. Documentation Obligatoire (Anti-Dette)
CACHED_FILES=$(git diff --cached --name-only)

# a) Si branche = fix/* -> RESEARCH_LOG.md obligatoire
if [[ "$BRANCH" == fix/* ]]; then
  if ! echo "$CACHED_FILES" | grep -q "RESEARCH_LOG.md"; then
    echo -e "\033[31mErreur: Documentation manquante pour ce correctif.\033[0m"
    echo "Vous devez modifier RESEARCH_LOG.md pour expliquer la cause racine (Playbook §6)."
    exit 1
  fi
fi

# b) Si package.json modifié -> ADR obligatoire (sauf version bumps couverts par ADR-003)
if echo "$CACHED_FILES" | grep -q "^package.json$"; then
  # Vérifier si c'est uniquement un version bump (changement du champ "version" uniquement)
  VERSION_CHANGE=$(git diff --cached package.json | grep -E '^\+.*"version"' | head -1)
  OTHER_CHANGES=$(git diff --cached package.json | grep -E '^\+.*"(name|description|keywords|repository|homepage|bugs|engines|files|scripts|dependencies|devDependencies)"' | head -1)
  
  # Si ce n'est pas un simple version bump, exiger un ADR spécifique
  if [ -n "$OTHER_CHANGES" ]; then
    if ! echo "$CACHED_FILES" | grep -q "^docs/explanation/adr/"; then
      echo -e "\033[31mErreur: Modification structurelle de package.json détectée sans ADR.\033[0m"
      echo "Les version bumps sont couverts par ADR-003, mais les autres changements nécessitent un ADR spécifique."
      echo "Veuillez justifier avec un nouveau fichier dans docs/explanation/adr/."
      exit 1
    fi
  fi
fi

# c) Si ENGINEERING_PLAYBOOK.md modifié -> synchroniser locales automatiquement
if echo "$CACHED_FILES" | grep -q "^ENGINEERING_PLAYBOOK.md$"; then
  echo -e "\033[33mSynchronisation automatique des fichiers locales avec ENGINEERING_PLAYBOOK.md...\033[0m"
  if [ -f "package.json" ] && grep -q '"sync-locales"' package.json; then
    npm run sync-locales
    echo -e "\033[32mFichiers locales synchronisés avec succès.\033[0m"
  else
    echo -e "\033[33mAvertisse: Script sync-locales non trouvé. Lancez 'npm run sync-locales' manuellement.\033[0m"
  fi
fi

exit 0
